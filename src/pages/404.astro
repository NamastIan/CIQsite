---
/** Built as `404.html` at the root: the platform answers every missing path with it. */
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="wrap narrow section center">
        <h1>This page is not here</h1>
    <p class="lede">The link may be old, or the address mistyped. Perhaps one of these is what you were looking for.</p>
    <div class="actions">
      <a class="button" href="/">Go to the home page</a>
      <a class="button ghost" href="/seven-levels/">The Seven Levels</a>
      <a class="button ghost" href="/blog/">Resources</a>
    </div>
  </section>
</Base>
