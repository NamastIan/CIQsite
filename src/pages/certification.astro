---
/**
 * Seven Levels Practitioner Certification sales page. Two Buy buttons: pay in
 * full (one-time) or seven monthly payments. Amounts must match the Payments
 * tab. No accreditation is claimed (ICF, ADRIC, SHRM are future targets only).
 */
import BuyButton from '../components/BuyButton.astro';
import Icon from '../components/Icon.astro';
import Mandala from '../components/Mandala.astro';
import Photo from '../components/Photo.astro';
import Placeholder from '../components/Placeholder.astro';
import {LEVELS} from '../content/levels';
import {CERTIFICATION as C, PRICES} from '../content/site';
import Base from '../layouts/Base.astro';
import {courseJsonLd} from '../lib/json-ld';
import online from '../assets/photos/online-study.jpg';

const description = `Become a ${C.credential}: ${C.hours} hours across ${C.sessions} live virtual ${C.day} sessions, with mediation and conflict coaching specializations.`;
const num = (amount: string) => amount.replace(/[^0-9.]/g, '');
const jsonLd = courseJsonLd({
  path: '/certification/',
  name: C.name,
  description,
  credential: C.credential,
  hours: C.hours,
  offers: [
    {name: 'Pay in full', price: num(PRICES.certificationFull.amount), currency: PRICES.currency},
    {name: `${PRICES.certificationPlan.count} monthly payments`, price: num(PRICES.certificationPlan.amount), currency: PRICES.currency},
  ],
  instances: C.cohorts.map(cohort => ({name: cohort.name, start: cohort.start || undefined, end: cohort.end || undefined})),
});
const first = C.cohorts.find(c => c.first);

const includes = [
  {title: `${C.hours} hours of live learning`, body: `${C.sessions} virtual sessions on ${C.day}s, in a small cohort that travels the whole way together.`},
  {title: 'The Conflict Exploration Kit', body: 'The physical card deck, shipped to you before session one.'},
  {title: 'Resolving From Within', body: 'A physical copy of Ian Renaud’s book, shipped to you before session one.'},
  {title: 'A private cohort space', body: 'A time-boxed group for session debriefs that rolls into the Certified Practitioners space when you graduate.'},
  {title: 'Six months of Community of Practice', body: 'Complimentary access for six months after the final session.'},
  {title: 'A Practitioners Directory listing', body: 'A listing in the Practitioners Directory as a Certified Seven Levels Practitioner.'},
];

const faq = [
  {
    q: 'Who is the Certification for?',
    a: 'Mediators, conflict coaches, ombuds, HR and conflict professionals, and people-first leaders who would like a deeper framework beneath their practice. No particular credential is required to join.',
  },
  {
    q: 'Is the Certification accredited?',
    a: 'Not at this time. The Certified Seven Levels Practitioner credential is awarded by Conflict Intelligence Training. We do not claim accreditation from any outside body.',
  },
  {
    q: 'What happens if I miss a session?',
    a: 'REPLACE: describe the recording and catch-up policy, and any attendance needed to certify.',
    placeholder: true,
  },
  {
    q: 'How do the seven monthly payments work?',
    a: `The first payment of ${PRICES.certificationPlan.amount} ${PRICES.currency} is taken at checkout, then one each month until all ${PRICES.certificationPlan.count} are paid, for the same total of ${PRICES.certificationFull.amount} ${PRICES.currency}.`,
  },
];
---

<Base title={C.name} description={description} jsonLd={jsonLd}>
  <header class="page-hero cert-hero">
    <div class="wrap split split-wide-left">
      <div>
        <p class="tag">Go Deep</p>
        <h1>{C.name}</h1>
        <p class="lede">
          Fourteen Thursdays to live inside the Seven Levels: as a framework, as a practice, and as a way of being with conflict. Graduates become <strong>{C.credential}s</strong>.
        </p>
        <dl class="facts hero-facts">
          <div>
            <dt>Format</dt>
            <dd>{C.hours} hours, {C.sessions} live virtual sessions on {C.day}s</dd>
          </div>
          {
            first && (
              <div>
                <dt>First cohort</dt>
                <dd>{first.label}</dd>
              </div>
            )
          }
          <div>
            <dt>Registration</dt>
            <dd>Open from {C.registrationOpens}</dd>
          </div>
        </dl>
        <div class="actions">
          <a class="button accent" href="#enrol">Enrol in the Certification <Icon name="arrow" /></a>
          <a class="button ghost" href="#journey">See the 14 sessions</a>
        </div>
      </div>
      <div class="cert-art">
        <Mandala label="The Seven Levels mandala at the heart of the Certification" />
      </div>
    </div>
  </header>

  <section class="band section" aria-labelledby="for-title">
    <div class="wrap split">
      <Photo src={online} alt="A laptop, notebook and coffee on a calm desk, ready for a live online session" width={560} height={420} sizes="(min-width: 900px) 540px, calc(100vw - 32px)" />
      <div>
        <h2 id="for-title">For practitioners ready for depth</h2>
        <p>
          Many of us carry tools for resolving conflict. Fewer of us have a map for understanding it from the inside. This Certification offers that map, and the time to make it
          our own, alongside a cohort of peers.
        </p>
        <p>
          It is designed for mediators, conflict coaches, ombuds, HR and conflict professionals, and people-first leaders. What might change in your practice if you could see
          all seven levels at once?
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="journey" id="journey-section">
    <div class="wrap">
      <div class="section-intro">
        <h2 id="journey">The journey: {C.sessions} sessions, {C.hours} hours</h2>
        <p class="lede">Live, virtual and unhurried, on {C.day}s.</p>
      </div>
      <ol class="journey">
        {
          C.structure.map(part => (
            <li>
              <span class="count">
                {part.count}
                <span class="visually-hidden">{part.count === 1 ? ' session' : ' sessions'}</span>
              </span>
              <div>
                <h3>{part.title}</h3>
                <p>{part.body}</p>
                {part.count === 7 && (
                  <ul class="level-chips" aria-label="One framework session per level">
                    {LEVELS.map(level => (
                      <li>
                        <span class="swatch" data-level={level.slug} />
                        {level.name}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
      <Placeholder label="Placeholder: session times" class="times">
        <p class="small">Add the session time and time zone, for example “Thursdays, 12:00 to 3:00 p.m. Eastern”.</p>
      </Placeholder>
    </div>
  </section>

  <section class="band section" aria-labelledby="includes-title">
    <div class="wrap">
      <h2 id="includes-title" class="section-intro">What is included</h2>
      <ul class="includes">
        {
          includes.map(item => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="cohorts-title">
    <div class="wrap split">
      <div>
        <h2 id="cohorts-title">Cohorts</h2>
        <p>Registration opens in {C.registrationOpens}. Each cohort meets live on {C.day}s.</p>
      </div>
      <ul class="cohorts">
        {
          C.cohorts.map(cohort => (
            <li>
              <h3>{cohort.name}</h3>
              <p>{cohort.label}</p>
              {cohort.first && <p class="tag">First cohort</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band-navy section" id="enrol" aria-labelledby="enrol-title">
    <div class="wrap">
      <div class="section-intro center">
        <h2 id="enrol-title">Enrol in the Certification</h2>
        <p class="lede">Two ways to pay, for the same Certification and the same total.</p>
      </div>
      <div class="pay">
        <div class="pay-card">
          <h3>Pay in full</h3>
          <p class="price"><strong>{PRICES.certificationFull.amount}</strong> <span>{PRICES.currency}</span></p>
          <p class="small">One payment at checkout.</p>
          <BuyButton price={PRICES.certificationFull.key} label="Enrol and pay in full" successPath="/thank-you/" />
        </div>
        <div class="pay-card">
          <h3>{PRICES.certificationPlan.count} monthly payments</h3>
          <p class="price"><strong>{PRICES.certificationPlan.amount}</strong> <span>{PRICES.currency} a month, {PRICES.certificationPlan.count} times</span></p>
          <p class="small">The first payment at checkout, then monthly.</p>
          <BuyButton price={PRICES.certificationPlan.key} label="Enrol with monthly payments" successPath="/thank-you/" variant="ghost" />
        </div>
      </div>
      <p class="center small enrol-note">The card deck and the book are shipped to the address you give us after checkout. Questions first? <a href="/contact/">Write to us</a>.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="voices-title">
    <div class="wrap">
      <h2 id="voices-title" class="section-intro">From practitioners</h2>
      <div class="grid grid-2">
        <Placeholder label="Placeholder testimonial: replace after the first cohort, with permission">
          <blockquote class="quote">
            <p>A reflection from a graduate on how the Seven Levels changed their practice.</p>
            <footer>Name, Certified Seven Levels Practitioner</footer>
          </blockquote>
        </Placeholder>
        <Placeholder label="Placeholder testimonial: replace after the first cohort, with permission">
          <blockquote class="quote">
            <p>A reflection on the cohort experience.</p>
            <footer>Name, role</footer>
          </blockquote>
        </Placeholder>
      </div>
    </div>
  </section>

  <section class="band section" aria-labelledby="faq-title">
    <div class="narrow">
      <h2 id="faq-title">Questions about the Certification</h2>
      <div class="faq">
        {
          faq.map(item =>
            item.placeholder ? (
              <Placeholder label="Placeholder: confirm this answer">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </Placeholder>
            ) : (
              <section>
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </section>
            )
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .cert-art {
    width: min(100%, 400px);
    justify-self: center;
  }
  .hero-facts {
    margin-top: 1.75rem;
  }
  .journey {
    display: grid;
    gap: 0;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .journey > li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.25rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .journey h3 {
    margin-bottom: 0.3rem;
  }
  .journey p {
    margin: 0;
  }
  .count {
    font-size: 2.75rem;
    font-weight: 650;
    line-height: 1;
    color: var(--accent-ink);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .journey > li:nth-child(odd) .count {
    color: var(--primary);
  }
  .level-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }
  .level-chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .includes {
    display: grid;
    gap: 2rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .includes li {
    padding-top: 1.1rem;
    border-top: 3px solid var(--primary);
  }
  .includes h3 {
    font-size: 1.25rem;
    margin-bottom: 0.35rem;
  }
  .includes p {
    margin: 0;
  }
  .cohorts {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cohorts li {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .cohorts h3 {
    font-size: 1.3rem;
    margin-bottom: 0.25rem;
  }
  .cohorts p {
    margin: 0;
  }
  .cohorts .tag {
    margin-top: 0.75rem;
  }
  .pay {
    display: grid;
    gap: 1.25rem;
    max-width: 880px;
    margin-inline: auto;
  }
  @media (min-width: 760px) {
    .pay {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pay-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--ink);
  }
  .pay-card h3 {
    color: var(--primary);
  }
  .pay-card .price span {
    color: var(--muted);
  }
  .pay-card :global(.button.ghost) {
    border-color: var(--primary);
    color: var(--primary);
  }
  .pay-card :global(.button.ghost:hover) {
    background: var(--surface);
  }
  .pay-card :focus-visible {
    outline-color: var(--primary);
  }
  .enrol-note {
    margin-top: 1.5rem;
    color: #dbe6f7;
  }
  .times {
    max-width: 640px;
  }
  .faq {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .faq section {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .faq h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }
  .faq p {
    margin: 0;
  }
</style>
