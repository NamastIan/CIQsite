---
/**
 * One page per level: `/seven-levels/<slug>/`, from src/content/levels.ts.
 * Listed in /sitemap.xml by src/pages/sitemap.xml.ts (dynamic routes are not found automatically).
 */
import Icon from '../../components/Icon.astro';
import Mandala from '../../components/Mandala.astro';
import {LEVELS, type Level, levelHref} from '../../content/levels';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return LEVELS.map((level, i) => ({
    params: {level: level.slug},
    props: {level, prev: LEVELS[i - 1], next: LEVELS[i + 1]},
  }));
}

interface Props {
  level: Level;
  prev?: Level;
  next?: Level;
}

const {level, prev, next} = Astro.props;
---

<Base title={`${level.name}: Level ${level.number} of the Seven Levels`} description={`${level.name}, level ${level.number} of the Seven Levels Framework. ${level.summary}`}>
  <article>
    <header class="level-hero">
      <div class="level-band" data-level={level.slug}></div>
      <div class="wrap split split-wide-left">
        <div>
          <p class="crumbs"><a href="/seven-levels/">The Seven Levels</a> <span aria-hidden="true">/</span> Level {level.number} of 7</p>
          <h1>{level.name}</h1>
          <p class="question">{level.question}</p>
          <p class="lede">{level.summary}</p>
        </div>
        <div class="level-art">
          <Mandala active={level.slug} label={`The Seven Levels mandala with ${level.name} highlighted`} />
        </div>
      </div>
    </header>

    <div class="wrap level-body">
      <section aria-labelledby="explores">
        <h2 id="explores">What this level explores</h2>
        {level.explores.map(paragraph => <p class="measure">{paragraph}</p>)}
      </section>

      <section aria-labelledby="shows" class="shows">
        <h2 id="shows">How conflict can show up here</h2>
        <ul class="ticks">
          {level.showsUp.map(item => <li>{item}</li>)}
        </ul>
      </section>
    </div>

    <section class="band section" aria-labelledby="reflect">
      <div class="wrap split">
        <div>
          <h2 id="reflect">Questions to sit with</h2>
          <p class="muted">There is no need to answer these quickly. We might return to them over a few days and notice what changes.</p>
        </div>
        <ul class="questions">
          {level.reflect.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="wrap section split" aria-labelledby="practice">
      <div class="practice">
        <h2 id="practice">A small practice: {level.practice.title}</h2>
        <p class="measure">{level.practice.body}</p>
      </div>
      <div class="card for-pros">
        <h3>For practitioners</h3>
        <p>{level.practitioners}</p>
        <a class="text-link" href="/certification/">About the Practitioner Certification <Icon name="arrow" /></a>
      </div>
    </section>

    <nav class="wrap level-nav" aria-label="Other levels">
      {
        prev ? (
          <a href={levelHref(prev)} class="level-step">
            <span class="small muted">Previous: Level {prev.number}</span>
            <span class="step-name">
              <span class="swatch" data-level={prev.slug} /> {prev.name}
            </span>
          </a>
        ) : (
          <a href="/seven-levels/" class="level-step">
            <span class="small muted">Overview</span>
            <span class="step-name">All seven levels</span>
          </a>
        )
      }
      {
        next ? (
          <a href={levelHref(next)} class="level-step level-step-next">
            <span class="small muted">Next: Level {next.number}</span>
            <span class="step-name">
              <span class="swatch" data-level={next.slug} /> {next.name}
            </span>
          </a>
        ) : (
          <a href="/challenge/" class="level-step level-step-next">
            <span class="small muted">Continue</span>
            <span class="step-name">The 7-Day Challenge</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .level-hero {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .level-band {
    height: 10px;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .crumbs {
    margin: 0 0 1rem;
    font-size: 0.925rem;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--muted);
  }
  .question {
    font-size: clamp(1.4rem, 1.4vw + 1rem, 2rem);
    line-height: 1.3;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.02em;
    max-width: 26ch;
  }
  .level-art {
    width: min(100%, 360px);
    justify-self: center;
  }
  .level-body {
    display: grid;
    gap: 2.5rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  @media (min-width: 900px) {
    .level-body {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 4rem;
    }
  }
  .for-pros {
    background: var(--surface);
    border: 0;
  }
  .for-pros h3 {
    font-size: 1.3rem;
  }
  .level-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .level-step {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--ink);
  }
  .level-step:hover {
    border-color: var(--primary);
    color: var(--ink);
  }
  .level-step-next {
    text-align: right;
  }
  .level-step-next .step-name {
    justify-content: flex-end;
  }
  .step-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    font-size: 1.1rem;
    color: var(--primary);
  }
</style>
