---
/**
 * Conflict Exploration Kit sales page. The Buy button sends only the price key
 * (PRICES.kit.key); the amount shown must match the Payments tab.
 */
import BuyButton from '../components/BuyButton.astro';
import CardDeck from '../components/CardDeck.astro';
import Icon from '../components/Icon.astro';
import Placeholder from '../components/Placeholder.astro';
import {LEVELS} from '../content/levels';
import {PRICES} from '../content/site';
import Base from '../layouts/Base.astro';
import {productJsonLd} from '../lib/json-ld';

const description = 'A physical card deck and digital suite for exploring any conflict through the Seven Levels Framework of Conflict Intelligence.';
const jsonLd = productJsonLd({
  path: '/exploration-kit/',
  name: 'Conflict Exploration Kit',
  description,
  price: PRICES.kit.amount.replace(/[^0-9.]/g, ''),
  currency: PRICES.currency,
});
---

<Base title="Conflict Exploration Kit" description={`${description} ${PRICES.kit.amount} ${PRICES.currency}.`} jsonLd={jsonLd}>
  <header class="page-hero">
    <div class="wrap split">
      <div>
        <p class="tag">Build Skills</p>
        <h1>Conflict Exploration Kit</h1>
        <p class="lede">
          A physical card deck and a digital suite for exploring any conflict through the seven levels. Something to hold in our hands when a conflict feels too large to hold
          in our heads.
        </p>
        <div class="buy-box">
          <p class="price"><strong>{PRICES.kit.amount}</strong> <span>{PRICES.currency}, card deck shipped to you, digital suite included</span></p>
          <BuyButton price={PRICES.kit.key} label="Buy the Kit" successPath="/thank-you/" />
        </div>
      </div>
      <div class="deck-art">
        <CardDeck />
      </div>
    </div>
  </header>

  <section class="band section" aria-labelledby="inside-title">
    <div class="wrap">
      <h2 id="inside-title" class="section-intro">What is inside</h2>
      <div class="split inside">
        <div>
          <h3>The card deck</h3>
          <p>
            A physical deck organized by the seven levels, from Space to Spirituality. Each card offers a question or a prompt to bring a level into view. We might draw one card
            before a difficult conversation, spread a full level across the table in a coaching session, or work through all seven with a team.
          </p>
          <ul class="level-chips" aria-label="The seven levels in the deck">
            {
              LEVELS.map(level => (
                <li>
                  <span class="swatch" data-level={level.slug} />
                  {level.name}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3>The digital suite</h3>
          <p>
            A companion set of digital resources that deepen the work of the deck: guidance for using the cards on our own, with another person, or with a group.
          </p>
          <Placeholder label="Placeholder: confirm the Kit contents">
            <p class="small">List exactly what the deck and digital suite include: number of cards, guides, worksheets, recordings, and the deck’s size and finish.</p>
          </Placeholder>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="uses-title">
    <div class="wrap">
      <h2 id="uses-title" class="section-intro">Ways to use the Kit</h2>
      <div class="grid grid-3 uses">
        <div>
          <h3>On our own</h3>
          <p>When a conflict keeps returning, we might lay out the seven levels and ask which one is speaking loudest today.</p>
        </div>
        <div>
          <h3>With a client</h3>
          <p>Mediators and coaches can invite a client to choose the cards that feel most true, opening conversations that words alone might not reach.</p>
        </div>
        <div>
          <h3>With a team</h3>
          <p>Leaders can bring a level into a team meeting, giving everyone a shared language for tension before it becomes rupture.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band section" aria-labelledby="owners-title">
    <div class="wrap split">
      <div>
        <h2 id="owners-title">Becoming a Kit Owner</h2>
        <p>After purchase, Kit Owners are invited to a Kit Owners webinar, where we explore the deck together. Kit Owners then receive a visible Kit Owner badge and their own space within the Conflict Intelligence Community.</p>
        <p class="small muted">The Kit is also included in the Seven Levels Practitioner Certification.</p>
      </div>
      <dl class="facts">
        <div>
          <dt>Price</dt>
          <dd>{PRICES.kit.amount} {PRICES.currency}</dd>
        </div>
        <div>
          <dt>Includes</dt>
          <dd>Physical card deck and digital suite</dd>
        </div>
        <div>
          <dt>Shipping</dt>
          <dd>The card deck is shipped to the address you give us after checkout</dd>
        </div>
        <div>
          <dt>Afterwards</dt>
          <dd>Kit Owners webinar, Kit Owner badge and Community space</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="voices-title">
    <div class="wrap">
      <h2 id="voices-title" class="section-intro">From Kit Owners</h2>
      <div class="grid grid-2">
        <Placeholder label="Placeholder testimonial: replace with a real Kit Owner’s words, used with permission">
          <blockquote class="quote">
            <p>A sentence on how the deck helped open a conversation.</p>
            <footer>Name, role</footer>
          </blockquote>
        </Placeholder>
        <Placeholder label="Placeholder testimonial: replace with a real Kit Owner’s words, used with permission">
          <blockquote class="quote">
            <p>A sentence on using the deck with clients or a team.</p>
            <footer>Name, role</footer>
          </blockquote>
        </Placeholder>
      </div>
    </div>
  </section>

  <section class="band-navy section" aria-labelledby="buy-title">
    <div class="narrow center">
      <h2 id="buy-title">Bring the seven levels to the table</h2>
      <p class="lede">The Conflict Exploration Kit, {PRICES.kit.amount} {PRICES.currency}. Card deck shipped to you, digital suite included.</p>
      <div class="actions buy-end">
        <BuyButton price={PRICES.kit.key} label="Buy the Kit" successPath="/thank-you/" />
        <a class="button ghost" href="/certification/">Or explore Certification <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .deck-art {
    width: min(100%, 520px);
    justify-self: center;
  }
  .buy-box {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .price span {
    color: var(--muted);
  }
  .inside {
    align-items: start;
  }
  .level-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .level-chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: 0.925rem;
    font-weight: 500;
  }
  .uses > div {
    padding-top: 1.25rem;
    border-top: 3px solid var(--accent);
  }
  .buy-end {
    align-items: flex-start;
  }
  .band-navy :global(.buy-status) {
    color: #dbe6f7;
  }
</style>
