---
/**
 * Beyond Resolution: A Conflict Intelligence Series for Practitioners (free).
 * Sign-up by email, or SIGNUP.seriesFormUrl when an email tool hosts it.
 */
import EmailForm from '../components/EmailForm.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Placeholder from '../components/Placeholder.astro';
import {SIGNUP} from '../content/site';
import Base from '../layouts/Base.astro';
import practitioners from '../assets/photos/practitioners-table.jpg';
---

<Base
  title="Beyond Resolution: A Conflict Intelligence Series for Practitioners"
  description="A free series for mediators, coaches, ombuds, HR and conflict professionals, exploring what lies beneath agreement through the Seven Levels Framework."
>
  <header class="page-hero">
    <div class="wrap split split-wide-left">
      <div>
        <p class="tag tag-free">Free series</p>
        <h1>Beyond Resolution</h1>
        <p class="subtitle">A Conflict Intelligence Series for Practitioners</p>
        <p class="lede">
          For mediators, coaches, ombuds, HR and conflict professionals. We know how to help people reach agreement. This series asks what lies beneath agreement, and what our
          work might become when we can see it.
        </p>
        <div class="actions">
          <a class="button accent" href="#join">Join the series <Icon name="arrow" /></a>
          <a class="button ghost" href="/seven-levels/">The Seven Levels</a>
        </div>
      </div>
      <Photo src={practitioners} alt="Professionals in discussion around a table with laptops and notes" width={560} height={420} sizes="(min-width: 900px) 460px, calc(100vw - 32px)" eager />
    </div>
  </header>

  <section class="band section" aria-labelledby="why-title">
    <div class="wrap split">
      <div>
        <h2 id="why-title">When the agreement is signed, and something remains</h2>
      </div>
      <div>
        <p>
          Most of us who work with conflict have seen it: the session that ends in agreement while something important stays untouched. The settlement that holds on paper and
          frays in practice. The team that resolves the issue and keeps the distance.
        </p>
        <p>
          Beyond Resolution is an invitation to look underneath. Drawing on the Seven Levels Framework, we explore what a conflict is made of, so that our processes can reach the
          levels where it actually lives.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="explore-title">
    <div class="wrap">
      <h2 id="explore-title" class="section-intro">What we explore together</h2>
      <div class="grid grid-3 themes">
        <div>
          <h3>Seeing the whole conflict</h3>
          <p>How to recognize which of the seven levels is active for each party, and why the loudest level is not always the deepest one.</p>
        </div>
        <div>
          <h3>Designing for depth</h3>
          <p>How Space, timing and process shape what becomes possible in mediation, coaching and workplace conversations.</p>
        </div>
        <div>
          <h3>The practitioner within</h3>
          <p>How our own emotions, identity and intuition enter the room, and how to work with them rather than around them.</p>
        </div>
      </div>
      <Placeholder label="Placeholder: series format" class="format">
        <p class="small">Describe the format here: how many parts the series has, how it is delivered (email, video, live sessions), and how often it arrives.</p>
      </Placeholder>
    </div>
  </section>

  <section class="band section" aria-labelledby="join-title">
    <div class="wrap split">
      <div>
        <h2 id="join-title">Join Beyond Resolution</h2>
        <p class="lede">The series is free. It is also a natural doorway to the Seven Levels Practitioner Certification, for those who would like to go further.</p>
        <p><a class="text-link" href="/certification/">About the Certification <Icon name="arrow" /></a></p>
      </div>
      <div class="card" id="join">
        <EmailForm
          id="series"
          subject="Join Beyond Resolution"
          messageLabel="A short note to join"
          messageHint="Your name and your practice (mediation, coaching, HR, ombuds…) are enough."
          template={'Please add me to Beyond Resolution: A Conflict Intelligence Series for Practitioners.\n\nMy name: \nMy practice: '}
          submitLabel="Join the series"
          formUrl={SIGNUP.seriesFormUrl}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .subtitle {
    margin: -0.25rem 0 1rem;
    font-size: clamp(1.2rem, 1vw + 1rem, 1.5rem);
    font-weight: 500;
    color: var(--ink);
  }
  .themes > div {
    padding-top: 1.25rem;
    border-top: 3px solid var(--primary);
  }
  .format {
    margin-top: 2rem;
  }
  #join {
    scroll-margin-top: 90px;
  }
</style>
