---
/** Small stroke icons, drawn once in one weight. Always decorative (aria-hidden). */
interface Props {
  name: 'arrow' | 'chevron' | 'menu' | 'close' | 'mail';
  class?: string;
}
const {name, class: className = name === 'chevron' ? 'chev' : name === 'arrow' ? 'arrow' : undefined} = Astro.props;
const paths: Record<Props['name'], string> = {
  arrow: 'M4 12h15m-6-6 6 6-6 6',
  chevron: 'm5 9 7 7 7-7',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6 6 18',
  mail: 'M4 6h16v12H4zM4 7l8 6 8-6',
};
---

<svg class={className} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={paths[name]}></path>
</svg>
