---
/**
 * A photo from src/assets/, optimised at build (AVIF + WebP, several widths).
 * Photos come from Unsplash and are placeholders the owner can replace:
 * drop a new file in src/assets/photos/ with the same name.
 */
import type {ImageMetadata} from 'astro';
import {Picture} from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Display box; the image fills it. */
  width: number;
  height: number;
  sizes: string;
  eager?: boolean;
  class?: string;
}

const {src, alt, width, height, sizes, eager = false, class: className} = Astro.props;
const widths = [480, 720, 960, 1280].filter(w => w <= src.width);
---

<Picture
  src={src}
  alt={alt}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : undefined}
  class:list={['photo', className]}
/>
