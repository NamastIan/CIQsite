---
/**
 * <head>, header and footer for every page. Pure HTML and CSS, and the
 * stylesheet is inlined (astro.config.mjs), so nothing blocks the first paint.
 * The only scripts are Astro's own, deferred modules from this host: prefetch
 * (`prefetch` in astro.config.mjs: a link the visitor points at is fetched
 * ahead) and client navigation (`<ClientRouter />`: a click swaps the next
 * page in without a reload and announces its title to screen readers). Every
 * page stays a real prerendered HTML file, so search sees the same pages.
 *
 * SEO for every page comes from the props: a unique `title` + `description`,
 * a canonical URL and `og:url` (when the site's address is known,
 * src/lib/site-url.ts), Open Graph + Twitter card tags, and links to the RSS
 * feed and the sitemap. Structured data (JSON-LD, src/lib/json-ld.ts): the
 * home page gets `WebSite` + `Organization`, a page passes its own in `jsonLd`
 * (a post's `BlogPosting`).
 */
import '../styles/global.css';

import {ClientRouter} from 'astro:transitions';

import BrandMark from '../components/BrandMark.astro';
import Icon from '../components/Icon.astro';
import {FOOTER, NAV, SITE, isGroup} from '../content/site';
import {type JsonLd, jsonLdText, siteJsonLd} from '../lib/json-ld';
import {absoluteUrl} from '../lib/site-url';

interface Props {
  /** The page's own name; the tab shows "<title> · <site>". Omit on home. */
  title?: string;
  /** The meta description (search results, social cards): ~150 characters. */
  description?: string;
  /** A social card image, 1200×630: a `/path` on this site or an https URL. */
  image?: string;
  /** Text for the social image (`og:image:alt`). */
  imageAlt?: string;
  /** `article` on a blog post (adds its dates), `website` elsewhere. */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** Keep this page out of search results (and the sitemap: src/pages/sitemap.xml.ts). */
  noindex?: boolean;
  /** The page's own structured data (src/lib/json-ld.ts), e.g. `postJsonLd(…)` on a post. */
  jsonLd?: JsonLd;
}

const {
  title,
  description = SITE.description,
  image,
  imageAlt,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const path = Astro.url.pathname;
const canonical = noindex ? null : absoluteUrl(path);
const socialImage = image ? absoluteUrl(image) : null;
const active = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href));
const current = (href: string) => (active(href) ? 'page' : undefined);
// The home page tells search engines the site's name; other pages bring their own.
const structured = [...(path === '/' ? [siteJsonLd()] : []), ...(jsonLd && !noindex ? [jsonLd] : [])];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {type === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href="/fonts/google-sans-flex-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {structured.map(data => <script type="application/ld+json" set:html={jsonLdText(data)} />)}
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label={`${SITE.name}, home`}>
          <BrandMark />
          <span>Conflict Intelligence <span>Training</span></span>
        </a>

        <div class="nav-desktop">
          <nav aria-label="Main">
            <ul class="nav-list">
              {
                NAV.map(item =>
                  isGroup(item) ? (
                    <li>
                      <details class:list={['nav-group', item.links.some(link => active(link.href)) && 'is-active']} data-dropdown>
                        <summary>
                          {item.label} <Icon name="chevron" />
                        </summary>
                        <ul class="nav-panel">
                          {item.links.map(link => (
                            <li>
                              <a href={link.href} aria-current={current(link.href)}>
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  ) : (
                    <li>
                      <a href={item.href} data-astro-prefetch="viewport" aria-current={current(item.href)}>
                        {item.label}
                      </a>
                    </li>
                  )
                )
              }
            </ul>
          </nav>
          <a class="button accent" href="/challenge/">Begin the Challenge</a>
        </div>

        <details class="nav-mobile" data-dropdown>
          <summary>
            <Icon name="menu" class="burger burger-open" />
            <Icon name="close" class="burger burger-close" />
            Menu
          </summary>
          <nav class="mobile-panel" aria-label="Main menu">
            {
              NAV.map(item =>
                isGroup(item) ? (
                  <>
                    <h2>{item.label}</h2>
                    <ul>
                      {item.links.map(link => (
                        <li>
                          <a href={link.href} aria-current={current(link.href)}>
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : null
              )
            }
            <h2>More</h2>
            <ul>
              <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
              {
                NAV.filter(item => !isGroup(item)).map(item => (
                  <li>
                    <a href={(item as {href: string}).href} aria-current={current((item as {href: string}).href)}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="button accent" href="/challenge/">Begin the 7-Day Challenge</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-about">
          <a href="/" class="brand">
            <BrandMark />
            <span>Conflict Intelligence <span>Training</span></span>
          </a>
          <p>{SITE.tagline} An online school and community for developing Conflict Intelligence through the Seven Levels Framework.</p>
        </div>
        {
          FOOTER.map(group => (
            <nav aria-label={`Footer: ${group.label}`}>
              <h2>{group.label}</h2>
              <ul>
                {group.links.map(link => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
      <div class="wrap footer-base">
        <span>© {new Date().getUTCFullYear()} {SITE.name}. Path B of {SITE.parent}.</span>
        <span><a href="/">Home</a></span>
      </div>
    </footer>

    <script>
      import {notifyPaymentOpener} from '../lib/checkout-session';
      import {installPageProgress} from '../lib/page-progress';

      installPageProgress();

      // Back from the payment provider INSIDE a Buy button's payment window: tell the page that
      // opened it (it checks the payment and goes on), then close (docs/agent/payments.md).
      document.addEventListener('astro:page-load', notifyPaymentOpener);

      // Header menus are <details>: they work without this. It only closes an open menu when
      // another opens, on a click outside, and on Escape (focus goes back to its toggle).
      const openMenus = () => [...document.querySelectorAll<HTMLDetailsElement>('details[data-dropdown][open]')];
      document.addEventListener('click', event => {
        const target = event.target as Element;
        for (const menu of openMenus()) {
          if (!menu.contains(target)) menu.open = false;
        }
      });
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        for (const menu of openMenus()) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
